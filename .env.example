# ==============================================================================
# OrderZero — Indian Stock Market SMC Platform (.env.example)
# Copy to .env and fill in your values. Never commit .env to version control.
# ==============================================================================

# --- OrderZero Brand & Theme ---
NEXT_PUBLIC_BRAND_NAME="OrderZero"
NEXT_PUBLIC_BG_COLOR="#09090B"
NEXT_PUBLIC_SURFACE_COLOR="#141417"
NEXT_PUBLIC_PRIMARY_COLOR="#10B981"
NEXT_PUBLIC_ACCENT_COLOR="#8B5CF6"
NEXT_PUBLIC_TEXT_COLOR="#FFFFFF"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_SMC_ENGINE_URL="http://localhost:8000"
NEXT_PUBLIC_DEMO_MODE="true"

# --- Core Infrastructure (Mumbai Region: AWS ap-south-1 / GCP asia-south1) ---
DATABASE_URL="postgresql://smc_user:change_me_strong_password@timescaledb:5432/smc_india"
REDIS_URL="redis://redis:6379/0"
CELERY_BROKER_URL="redis://redis:6379/1"
CELERY_RESULT_BACKEND="redis://redis:6379/2"

# --- Security & DPDP Act 2023 Encryption ---
# Generate with: python3 -c "import secrets, base64; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
TOKEN_ENCRYPTION_KEY="REPLACE_WITH_32_BYTE_URLSAFE_BASE64_KEY"
JWT_SECRET="REPLACE_WITH_64_CHAR_RANDOM_SECRET"
NEXTAUTH_SECRET="REPLACE_WITH_64_CHAR_RANDOM_SECRET"
NEXTAUTH_URL="http://localhost:3000"

# --- Primary Live Broker: DhanHQ API v2 (User connects their OWN account) ---
DHAN_PARTNER_ID=""
DHAN_PARTNER_SECRET=""
DHAN_API_BASE_URL="https://api.dhan.co/v2"
DHAN_WS_FEED_URL="wss://api-feed.dhan.co"

# --- Optional Additional Broker Adapters ---
KITE_API_KEY=""
KITE_API_SECRET=""
UPSTOX_CLIENT_ID=""
UPSTOX_CLIENT_SECRET=""
ANGELONE_API_KEY=""
FYERS_APP_ID=""
FYERS_SECRET_ID=""

# --- Payments & GST Invoicing (India — Step 4) ---
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
COMPANY_LEGAL_NAME="OrderZero Technologies"
COMPANY_GSTIN="27AAAAA0000A1Z5"
GST_RATE_PERCENT="18"

# --- Alert Delivery Channels (Step 4) ---
SMTP_HOST="smtp.resend.com"
SMTP_PORT="587"
SMTP_USER="resend"
SMTP_PASS=""
EMAIL_FROM="alerts@orderzero.in"
TELEGRAM_BOT_TOKEN=""
WHATSAPP_BUSINESS_PHONE_NUMBER_ID=""
WHATSAPP_BUSINESS_ACCESS_TOKEN=""
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
